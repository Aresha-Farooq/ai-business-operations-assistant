enum UserRole {
  OWNER
  MANAGER
  STAFF
}

model Organization {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
inventoryMovements InventoryMovement[]
  users     User[]
  customers Customer[]
}

model User {
  id             Int      @id @default(autoincrement())
  name           String
  email          String   @unique
  passwordHash   String
  organizationId Int
  role           UserRole @default(STAFF)

  organization Organization @relation(
    fields: [organizationId],
    references: [id]
  )

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Customer {
  id             Int                @id @default(autoincrement())
  name           String
  email          String
  phone          String?
  organizationId Int
  isActive       Boolean            @default(true)
  deletedAt      TimestamptzString?

  organization Organization @relation(
    fields: [organizationId],
    references: [id]
  )

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Product {
  id             Int      @id @default(autoincrement())
  name           String
  description    String?
  sku            String
  purchasePrice  Float
  salePrice      Float
  stockQuantity  Int      @default(0)
  minimumStock   Int      @default(0)

  organizationId Int

  isActive       Boolean  @default(true)
  deletedAt      TimestamptzString?

  organization Organization @relation(fields: [organizationId], references: [id])

  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
}


model InventoryMovement {
  id             Int      @id @default(autoincrement())
  productId      Int
  organizationId Int
  quantity       Int
  type           InventoryMovementType
  reason         String?

  product      Product      @relation(fields: [productId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

enum InventoryMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  DAMAGE
}


enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Order {
  id             Int         @id @default(autoincrement())
  customerId     Int
  organizationId Int
  status         OrderStatus @default(PENDING)
  totalAmount    Float

  customer       Customer    @relation(
    fields: [customerId],
    references: [id]
  )

  organization   Organization @relation(
    fields: [organizationId],
    references: [id]
  )

  items          OrderItem[]
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  unitPrice Float

  order     Order   @relation(
    fields: [orderId],
    references: [id]
  )

  product   Product @relation(
    fields: [productId],
    references: [id]
  )

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}